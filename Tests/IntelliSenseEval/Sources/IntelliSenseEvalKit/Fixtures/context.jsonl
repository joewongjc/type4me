{"id":"cx01","suite":"context","tags":["terminology","asr-correction"],"inputText":"这个版本明天可以交付，不过要先完成回归测试，特别是 Queen 三 ASR 的基准能力测试。","application":{"bundleIdentifier":"com.apple.Notes","appName":"Notes","category":"document"},"control":"multiLine","contextBefore":"Qwen3-ASR 的发布计划调整到了周四，负责人是 Max。","contextAvailability":"full","enabledAwareness":{"application":true,"context":true,"expression":false,"correction":false},"intentSummary":"依据附近术语将Queen三ASR修正为Qwen3-ASR，不引入周四或Max。","expectedContextUse":"仅采用Qwen3-ASR准确写法。","mustPreserve":["Qwen3-ASR","明天","回归测试"],"mustRemove":["Queen 三 ASR"],"mustNotAdd":["周四","Max"],"mustChange":true,"smoke":true,"critical":true}
